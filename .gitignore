.env
.DS_Store
__pycache__/
memory/
# Runtime-generated files (voice output, etc.) live directly under
# static/ -- but static/css, static/js, static/vendor (the vendored
# wllama build for offline mode), static/icons, and static/manifest.json
# hold real source/assets, so those are tracked.
static/*
!static/css/
!static/css/**
!static/js/
!static/js/**
!static/vendor/
!static/vendor/**
!static/icons/
!static/icons/**
!static/manifest.json
budget.json
logs/
veronica_backups/
.turso_migration_state.json
