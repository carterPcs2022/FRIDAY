.env
.DS_Store
# Google OAuth client-secret files download under exactly this name from
# console.cloud.google.com. Nothing here reads them (credentials come
# from env vars) -- this is purely so one landing in the repo folder
# can't be committed by accident.
client_secret*.json
__pycache__/
memory/
# Runtime-generated files (voice output, etc.) live directly under
# static/ -- but static/css, static/js, static/vendor (the vendored
# wllama build for offline mode), static/icons, and static/manifest.json
# hold real source/assets, so those are tracked.
static/*
!static/css/
!static/css/**
!static/js/
!static/js/**
!static/vendor/
!static/vendor/**
!static/icons/
!static/icons/**
!static/manifest.json
budget.json
logs/
veronica_backups/
.turso_migration_state.json
